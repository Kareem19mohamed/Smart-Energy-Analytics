# Copy this file to .env and fill in your own values. Never commit .env.

# SQL Server on your machine (reached from the container via host.docker.internal)
SQL_SERVER=host.docker.internal
SQL_PORT=1433
SQL_DATABASE=ElectricityDB
SQL_USER=airflow_user
SQL_PASSWORD=change_me
SQL_DRIVER=ODBC Driver 17 for SQL Server

# Paths inside the container (leave as is)
DATA_ROOT=/opt/airflow/data
DATA_DIR=/opt/airflow/data/cleaned
STAGING_DIR=/opt/airflow/data/staging
RAW_DATA_DIR=/opt/airflow/raw
PROCESSED_DIR=/opt/airflow/data/processed

# OPTIONAL: folder with the raw data (target_houses) on YOUR machine.
# Use forward slashes. If unset, the DAG skips ingest_raw and starts from data/processed.
# RAW_HOST_DIR=C:/path/to/target_houses